{
  "name": "sinwar-7",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run data:build && npm run data:validate && npm run db:seed:build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "data:build": "node --experimental-strip-types scripts/build-accounts.ts",
    "data:validate": "node --experimental-strip-types scripts/validate-accounts.ts",
    "db:seed:build": "node --experimental-strip-types scripts/build-supabase-seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "fuse.js": "^7.5.0",
    "motion": "^13.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.5.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
