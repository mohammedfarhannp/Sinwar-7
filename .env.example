# Public build-time flags. These control which optional sections are available.
VITE_ENABLE_DONATE=false
VITE_ENABLE_STORES_APPS=false

# Server-only Vercel Function settings. Do not prefix these with VITE_.
SUPABASE_URL=https://ncdkujrjcrdarjijeteg.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-secret

# Legacy alternative supported by the server if the project has no sb_secret_ key:
# SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
