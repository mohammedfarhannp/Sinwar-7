# Public build-time flags. These control which optional sections are available.
VITE_ENABLE_DONATE=false
VITE_ENABLE_STORES_APPS=false

# Vercel Function settings. The API uses this publishable key with database RLS.
# Do not add a VITE_ prefix unless a browser-side Supabase client is introduced.
SUPABASE_URL=https://ncdkujrjcrdarjijeteg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key

# Avatar enrichment is server-only. Never prefix these values with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
ADMIN_SECRET=
ENRICH_BATCH_SIZE=3
ENRICH_DELAY_MS_MIN=2000
ENRICH_DELAY_MS_MAX=3000
